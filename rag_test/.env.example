# ============================================
# RAG Test Pipeline - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- MongoDB (your existing DB) ---
MONGODB_URI=mongodb+srv://admin:PASSWORD@legislatura.xm7wst4.mongodb.net/
MONGODB_DB=test

# --- OpenRouter (for LLM + embeddings) ---
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=x-ai/grok-4.1-fast
OPENROUTER_RERANK_MODEL=google/gemini-2.0-flash-lite-001
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (free tier: https://www.pinecone.io/) ---
PINECONE_API_KEY=pcsk_xxx
PINECONE_INDEX_NAME=legislatura-expedientes
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Qdrant (self-hosted on AWS EC2) ---
QDRANT_URL=http://ec2-3-220-230-20.compute-1.amazonaws.com:6333
QDRANT_COLLECTION_NAME=legislatura-expedientes

# --- RAG Configuration ---
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
EMBEDDING_DIMS=1536
RAG_TOP_K=10
RAG_MIN_SCORE=0.68
RAG_RRF_K=60
RAG_RERANK_WEIGHT=0.7
RAG_FUSION_WEIGHT=0.3

# --- Optional: Redis (for semantic cache) ---
REDIS_URL=redis://localhost:6379/0
CACHE_SIMILARITY_THRESHOLD=0.95

# --- Processing ---
MAX_EXPEDIENTES=500
EMBEDDING_BATCH_SIZE=50

# --- FastAPI Bridge ---
RAG_API_PORT=8100
